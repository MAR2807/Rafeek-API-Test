
install python:
python -m venv .venv

create venv at root
.\.venv\Scripts\Activate.ps1

install pytest and requests inside venv

# 1. Initialize the repository
git init

# 2. Create an initial commit
git add .
git commit -m "Initial commit"

# 3. Rename the default branch
git branch -M main

git remote add origin https://github.com/MAR2807/-Rafeek---API-Test.git
git push -u origin main

verify git works:
git remote -v
git status

deleting venv:
    run:  deactivate
    run:  Remove-Item -Recurse -Force .\.venv